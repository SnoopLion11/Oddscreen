# Copy to .env (git-ignored) and fill in. Never commit .env.
# Required fields per platform will be finalised once each platform's API
# docs have been read and confirmed; nothing below is used yet.

# --- Kalshi (see docs/kalshi_api.md) ---
# Key ID and private key (RSA or Ed25519 PEM) from Kalshi account settings.
# The combo RFQ recorder needs trade scope: it creates combo markets and RFQs
# (it never accepts quotes or places orders).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem
# Optional; defaults to production. Use --demo for the demo environment.
# KALSHI_API_URL=https://external-api.kalshi.com/trade-api/v2

# --- ESX (real-money key, starts with esx_live_) ---
# Settings -> API Keys in the ESX app. The secret is shown once.
# Market data needs only this key; no password or login token.
ESX_API_KEY=
ESX_API_URL=https://api.empiresportsexchange.com
# Optional; defaults to wss://<host of ESX_API_URL>/v1/marketdata
# ESX_WS_URL=
# --- Polymarket US (pending docs.polymarket.us) ---
# --- NoVig (key required; exact fields pending docs.novig.com) ---
NOVIG_API_KEY=
